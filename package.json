{
  "name": "crossweave",
  "version": "0.5.0",
  "description": "Run N parallel coding sessions on one repo — a git worktree plus your shell each — with per-session ports, background trial merges and evidence-gated landing",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.13"
  },
  "os": ["darwin", "linux"],
  "bin": {
    "cw": "./src/cli/index.ts",
    "cwd": "./src/daemon/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run scripts/build.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.3",
    "@opentui/keymap": "0.5.3",
    "@xterm/headless": "6.0.0",
    "citty": "^0.2.2",
    "simple-git": "^3.36.0",
    "web-tree-sitter": "0.26.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "web-tree-sitter@0.26.12": "patches/web-tree-sitter@0.26.12.patch"
  }
}
