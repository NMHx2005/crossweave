{
  "name": "@crossweave/cockpit",
  "version": "0.3.0",
  "private": true,
  "description": "crossweave Cockpit — Electron thin client for cwd",
  "main": "dist-electron/main.js",
  "type": "module",
  "os": ["darwin"],
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cwd": "cd ../.. && bun run build",
    "package:mac": "electron-builder --mac --arm64 --config electron-builder.yml",
    "dist:mac": "bun run build:cwd && bun run build && bun run package:mac",
    "package:smoke": "bun scripts/package-smoke.ts",
    "fidelity:resize": "bun scripts/fidelity-resize.ts",
    "preview": "vite preview",
    "test": "bun test",
    "smoke": "bun test"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.15.3",
    "electron": "44.4.1",
    "electron-builder": "26.0.12",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-electron": "1.1.2"
  }
}
